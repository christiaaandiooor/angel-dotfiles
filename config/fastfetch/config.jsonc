// ˚₊‧꒰ა Angel fastfetch ໒꒱ ‧₊˚   (backup: config.jsonc.bak-lindo)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logos/k-angel.png",
    "width": 38,
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 16 },
    "color": { "separator": "#e25da4" }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "   (≧◡≦) ♡ {user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": { "user": "#ff8fc8", "at": "#c3a6f5", "host": "#8fcff7" }
    },
    { "type": "custom", "format": "{#38;2;195;166;245}   ˚₊‧꒰ა ☆ ─────────────────────── ☆ ໒꒱‧₊˚" },

    { "type": "custom", "format": "{#1;38;2;255;143;200}╭─  Sistema" },
    { "type": "os",       "key": "│ 󰣇  Distro",    "keyColor": "#ff8fc8", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "│   Kernel",    "keyColor": "#ff8fc8" },
    { "type": "packages", "key": "│ 󰏖  Paquetes",  "keyColor": "#ff8fc8" },
    { "type": "shell",    "key": "│   Shell",     "keyColor": "#ff8fc8" },
    { "type": "uptime",   "key": "│ 󰅐  Despierta", "keyColor": "#ff8fc8" },

    { "type": "custom", "format": "{#1;38;2;195;166;245}├─ 󰧨 Escritorio" },
    { "type": "wm",           "key": "│   Ventanas", "keyColor": "#c3a6f5" },
    { "type": "theme",        "key": "│ 󰉼  Tema",     "keyColor": "#c3a6f5" },
    { "type": "icons",        "key": "│ 󰀻  Iconos",   "keyColor": "#c3a6f5" },
    { "type": "cursor",       "key": "│ 󰆿  Cursor",   "keyColor": "#c3a6f5" },
    { "type": "terminal",     "key": "│   Terminal", "keyColor": "#c3a6f5" },
    { "type": "terminalfont", "key": "│   Fuente",   "keyColor": "#c3a6f5" },

    { "type": "custom", "format": "{#1;38;2;143;207;247}├─  Hardware" },
    { "type": "host",    "key": "│ 󰌢  Equipo",   "keyColor": "#8fcff7" },
    { "type": "cpu",     "key": "│ 󰻠  CPU",      "keyColor": "#8fcff7" },
    { "type": "gpu",     "key": "│ 󰢮  GPU",      "keyColor": "#8fcff7", "format": "{name}" },
    { "type": "display", "key": "│ 󰍹  Pantalla", "keyColor": "#8fcff7", "compactType": "original-with-refresh-rate" },
    { "type": "memory",  "key": "│ 󰾆  Memoria",  "keyColor": "#8fcff7" },
    { "type": "disk",    "key": "│ 󰋊  Disco",    "keyColor": "#8fcff7", "folders": "/" },
    { "type": "battery", "key": "│ 󰁹  Batería",  "keyColor": "#8fcff7" },

    { "type": "custom", "format": "{#1;38;2;226;93;164}├─ 󰝚 Música" },
    { "type": "sound",  "key": "│ 󰕾  Audio",    "keyColor": "#e25da4", "format": "{name}" },
    { "type": "media",  "key": "│ 󰎆  Sonando",  "keyColor": "#e25da4" },

    { "type": "custom", "format": "{#38;2;255;143;200}╰───────────── ♡ ─────────────" },
    "break",
    { "type": "custom", "format": "   {#38;2;255;143;200}♥  {#38;2;226;93;164}♥  {#38;2;195;166;245}♥  {#38;2;143;207;247}♥  {#38;2;169;139;187}♥  {#38;2;91;59;110}♥{#}   {#38;2;169;139;187}Hola de nuevo ✧˖°" },
    "break"
  ]
}
